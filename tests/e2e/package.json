{
  "name": "homestead-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for Homestead using Playwright",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "report": "playwright show-report",
    "clean": "rm -rf test-results playwright-report aep_test_data"
  },
  "keywords": [
    "e2e",
    "playwright",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@rambleraptor/homestead-client": "^0.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^22.10.2",
    "typescript": "^6.0.2"
  }
}
