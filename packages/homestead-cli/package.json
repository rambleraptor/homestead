{
  "name": "@rambleraptor/homestead-cli",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/rambleraptor/homestead#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rambleraptor/homestead.git",
    "directory": "packages/homestead-cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "homestead": "bin/homestead.mjs"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "start:node": "tsx src/cli.ts",
    "test": "bun test",
    "test:node": "vitest run",
    "prepack": "node -e \"require('fs').accessSync('bin/homestead.mjs')\" || (echo 'ERROR: bin/homestead.mjs is missing — the homestead command will not be installed. Check that it is not gitignored.' && exit 1)"
  },
  "dependencies": {
    "@aep_dev/aep-lib-ts": "^0.0.2",
    "@rambleraptor/homestead-client": "^0.2.0",
    "@rambleraptor/homestead-core": "^0.2.0",
    "@rambleraptor/homestead-apps": "^0.2.0",
    "axios": "^1.6.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "vitest": "^4.0.15"
  }
}
