  "//optionalDependencies": "Native deps ship per-platform prebuilt binaries as their own optional deps; the lockfile only captures variants resolved at generation time. We pin both supported targets explicitly — linux-arm64 (deploy) and darwin-arm64 (dev) — so `npm install`/`npm ci` work on both and sharp never builds from source. These live here (not the workspace root) because this package owns the tooling that pulls them in: vite → rollup/esbuild/lightningcss, tailwindcss → oxide/lightningcss, sharp → libvips. Keep each version in sync with its parent package.",
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.53.5",
